# ---- Telegram ----
# Get a token from @BotFather. IMPORTANT: enable inline mode for the bot
# (@BotFather -> /setinline) or inline queries will never arrive.
BOT_TOKEN=123456:your-telegram-bot-token

# ---- SearXNG backend ----
# In docker-compose this is overridden to http://searxng:8080.
SEARXNG_URL=http://localhost:8080
# A long random string. Generate: openssl rand -hex 32
SEARXNG_SECRET=please-change-me
# Pin a real dated tag from hub.docker.com/r/searxng/searxng/tags (recommended).
SEARXNG_TAG=latest

# Pinned, reliable engines per category (one broken scraper then can't blank the
# whole category, and latency stays predictable).
ENGINES_IMAGES=bing images,duckduckgo images
ENGINES_VIDEOS=youtube,dailymotion
# 0=off (show everything), 1=moderate, 2=strict
SAFE_SEARCH=0
# Keep false unless SearXNG itself is publicly reachable over HTTPS — Telegram
# fetches inline media URLs server-side and can't reach a proxied URL on an
# internal-only instance.
IMAGE_PROXY=false

# ---- Search behaviour ----
REQUEST_TIMEOUT=8s
MAX_RESULTS=50          # Telegram hard-caps inline answers at 50
DEBOUNCE_DELAY=250ms

# ---- Cache / concurrency ----
CACHE_TTL=5m
CACHE_SIZE=2048
WORKERS=32
INLINE_CACHE_TIME=300   # answerInlineQuery cache_time (seconds)

# ---- Health ----
HEALTH_ADDR=:8081

# ---- Postgres: search analytics (stats) ----
# Searchy's own logical schema. It holds ONLY private search analytics — counts and
# timings of searches/selections, never the query text. Identity and the user's
# saved language do NOT live here anymore (they moved to the shared "core"
# Postgres below); the old local `users` table is dropped on startup.
# On WS04 this connection and CORE_DATABASE_URL both point to one physical
# core-postgres instance, but use different privilege/search_path boundaries.
# The analytics schema has no profile/presence/language rows; analytics still
# key counts on the raw Telegram user id and never store the query or result URL.
# Set a strong password: openssl rand -hex 24
POSTGRES_PASSWORD=please-change-me
# For a standalone/local run, point DATABASE_URL at your own Postgres instead:
# DATABASE_URL=postgres://searchy:pass@localhost:5432/searchy?sslmode=disable
# Leave DATABASE_URL empty to run without analytics (the bot still works; /stats off).

# ---- Postgres: shared cross-bot "core" (identity, presence, language) ----
# Vido, Searchy, Quoto, Branchy, and makeitMD share ONE "core" Postgres, keyed
# on the global Telegram id. searchy connects with a least-privilege role
# (searchy_core) and reads/writes only through core's SECURITY DEFINER functions
# (core.touch / core.set_language / core.effective_language). Identity, presence
# and the user's saved language live here, shared across all the bots.
# Leave CORE_DATABASE_URL empty to disable core integration (the bot still works;
# language falls back to the Telegram client's language hint).
# CORE_DATABASE_URL=postgres://searchy_core:pass@core-postgres:5432/core?sslmode=disable

# ---- Vido bridge (off by default) ----
# @username (without @) of the Vido bot. Inline download buttons use its
# owner-bound /start deep link; DM/group cards are delivered by Searchy.
VIDO_BOT_USERNAME=
VIDO_BRIDGE_ENABLED=false

# Shared local Telegram Bot API. Leave empty to keep api.telegram.org.
TELEGRAM_BOT_API_BASE_URL=
# The same host directory is mounted read-only into Searchy and Bot API.
SHARED_MEDIA_CACHE_DIR=/shared-media-cache
